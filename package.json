{
  "name": "errand-knight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Turn real life into a quest log. Local-first gamified productivity, built by agents.",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "pnpm run skills:check && pnpm run scripts:test",
    "skills:check": "node scripts/check-skills.mjs",
    "scripts:test": "node --test \"scripts/**/*.test.mjs\"",
    "jev:triage": "node scripts/jev/triage-cli.mjs",
    "jev:prune": "node scripts/jev/prune-cli.mjs"
  },
  "devDependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  }
}
